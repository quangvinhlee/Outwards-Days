# Run pnpm setup:local to generate .env and apps/mobile/.env automatically.
# API configuration (server-side only).
NODE_ENV=development
PORT=3100
MONGODB_DB=outsideweek
MONGODB_URI=mongodb://outsideweek:<generated-app-password>@127.0.0.1:27019/outsideweek?authSource=outsideweek

# Local Docker MongoDB. Setup generates independent random passwords.
MONGO_PORT=27019
MONGO_ROOT_USERNAME=outsideweek_admin
MONGO_ROOT_PASSWORD=<generated-admin-password>
MONGO_APP_PASSWORD=<generated-app-password>

# Local Ollama requires no service token. A remote production proxy requires one.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e2b
OLLAMA_SERVICE_TOKEN=
INFERENCE_TIMEOUT_MS=90000
SESSION_TTL_DAYS=30
WEATHER_BASE_URL=https://api.open-meteo.com
# Production web origin, such as https://outsideweek.example; omit for local web.
# WEB_ORIGIN=
# Optional production routing service implementing the OSRM route API.
# ROUTING_BASE_URL=https://your-routing-service

# Optional managed Photon instance for production nearby park lookup.
# PHOTON_BASE_URL=https://your-photon-service

# Optional managed Overpass-compatible endpoint for production place discovery.
# Local development uses the public Overpass instance at a low request rate.
# OVERPASS_BASE_URL=https://your-managed-instance/api/interpreter

# Optional, server-only. SerpApi adds nearby park results when configured.
SERPAPI_API_KEY=
