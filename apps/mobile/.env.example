# Public configuration only; no database, model or provider secrets here.
# pnpm setup:local writes your computer's LAN IP for physical-phone use.
# Android emulator may alternatively use http://10.0.2.2:3100.
EXPO_PUBLIC_API_BASE_URL=http://192.168.x.x:3100
# For a hosted browser build whose API is on a different host or port.
# EXPO_PUBLIC_WEB_API_BASE_URL=https://api.your-domain.example
