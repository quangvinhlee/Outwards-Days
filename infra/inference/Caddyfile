{$INFERENCE_HOST} {
  @chat {
    path /api/chat
    method POST
    header Authorization "Bearer {$OLLAMA_SERVICE_TOKEN}"
  }
  handle @chat {
    request_body {
      # Photo mission requests include a resized image encoded as base64.
      max_size 2MB
    }
    reverse_proxy 127.0.0.1:11434 {
      header_up -Authorization
      transport http {
        response_header_timeout 100s
      }
    }
  }
  handle {
    respond "Unauthorized or unsupported endpoint" 401
  }
}
